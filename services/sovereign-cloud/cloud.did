// Account IDs and space IDs are stable within a logical service, not a deployment address.
type Account = record {
  id : nat64;
  owner : principal;
  created_at : nat64;
  personal_space : nat64;
};
type AccountContext = record {
  used_bytes : nat64;
  quota_bytes : nat64;
  account : Account;
};
type BeginUpload = record {
  request_id : text;
  sha256 : blob;
  bytes : nat64;
  project_id : nat64;
  expected_revision : opt nat64;
};
type FileDetails = record {
  kind : FileKind;
  space_id : nat64;
  project : Project;
};
type FileKind = record {
  format_id : text;
  format_version : nat32;
  created_by_app : text;
};
type FilePage = record { files : vec FileSummary; next_cursor : opt nat64 };
type FileSummary = record {
  id : nat64;
  kind : FileKind;
  name : text;
  version_count : nat64;
  latest : Revision;
  space_id : nat64;
};
type Project = record {
  id : nat64;
  revisions : vec Revision;
  owner : principal;
  name : text;
  created_at : nat64;
  pending_upload : opt nat64;
};
type Result = variant { Ok : Upload; Err : text };
type Result_1 = variant { Ok : Revision; Err : text };
type Result_2 = variant { Ok : Project; Err : text };
type Result_3 = variant { Ok; Err : text };
type Result_4 = variant { Ok : blob; Err : text };
type Result_5 = variant { Ok : FileDetails; Err : text };
type Result_6 = variant { Ok : AccountContext; Err : text };
type Result_7 = variant { Ok : vec Project; Err : text };
type Result_8 = variant { Ok : FilePage; Err : text };
type Revision = record {
  id : nat64;
  sha256 : blob;
  created_at : nat64;
  author : principal;
  chunk_count : nat64;
  bytes : nat64;
};
type Upload = record {
  id : nat64;
  request : BeginUpload;
  created_at : nat64;
  committed : opt Revision;
};
service : () -> {
  begin_upload : (BeginUpload) -> (Result);
  commit_upload : (nat64) -> (Result_1);
  create_file : (text, FileKind) -> (Result_2);
  create_project : (text) -> (Result_2);
  delete_project : (nat64) -> (Result_3);
  delete_revision_or_upload : (nat64) -> (Result_3);
  get_chunk : (nat64, nat64, nat64) -> (Result_4) query;
  get_file : (nat64, nat64) -> (Result_5);
  get_or_create_account : () -> (Result_6);
  get_revision : (nat64, nat64) -> (Result_1);
  list_app_files : (FileKind) -> (Result_7);
  list_files : (nat64, opt nat64, nat32) -> (Result_8);
  list_projects : () -> (Result_7);
  put_chunk : (nat64, nat64, blob) -> (Result_3);
}
